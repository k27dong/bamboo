{
  "name": "bamboo",
  "version": "5.1.0",
  "private": true,
  "description": "Discord bot embedded with NetEase Music Api (从网易云播放的discord机器人)",
  "homepage": "https://github.com/k27dong/bamboo#readme",
  "bugs": {
    "url": "https://github.com/k27dong/bamboo/issues",
    "email": "me@kefan.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k27dong/bamboo.git"
  },
  "license": "MIT",
  "author": "k27dong",
  "type": "module",
  "main": "dist/sharding.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "pnpm type-check && NODE_ENV=development node esbuild.config.js",
    "start": "NODE_ENV=development node --enable-source-maps --no-deprecation dist/sharding.js",
    "dev": "pnpm build && pnpm start",
    "build:prod": "pnpm type-check && NODE_ENV=production node esbuild.config.js",
    "start:prod": "NODE_ENV=production node --enable-source-maps --no-deprecation dist/sharding.js",
    "prod": "pnpm build:prod && pnpm start:prod",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix && prettier --write .",
    "flush:dev": "NODE_ENV=development tsx src/common/scripts/flush.ts",
    "deploy:dev": "NODE_ENV=development tsx src/common/scripts/deploy.ts dev",
    "deploy:prod": "NODE_ENV=production tsx src/common/scripts/deploy.ts global",
    "check": "tsx src/common/scripts/checkDep.ts"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@neteasecloudmusicapienhanced/api": "^4.40.0",
    "@snazzah/davey": "0.1.12",
    "bufferutil": "^4.1.0",
    "chalk": "^6.0.0",
    "discord-player": "^7.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "openai": "^7.4.0",
    "qrcode-terminal": "^0.12.0",
    "sodium-native": "^5.1.0",
    "topgg-autoposter": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=11"
  }
}
