{
  "name": "bamboo",
  "version": "5.1.0",
  "private": true,
  "description": "Discord bot embedded with NetEase Music Api (从网易云播放的discord机器人)",
  "homepage": "https://github.com/k27dong/bamboo#readme",
  "bugs": {
    "url": "https://github.com/k27dong/bamboo/issues",
    "email": "me@kefan.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k27dong/bamboo.git"
  },
  "license": "MIT",
  "author": "k27dong",
  "type": "module",
  "main": "dist/manager.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "pnpm type-check && NODE_ENV=development node esbuild.config.js",
    "start": "node src/scripts/withSettings.ts dev node --enable-source-maps --no-deprecation dist/manager.js",
    "dev": "pnpm build && pnpm start",
    "build:prod": "pnpm type-check && NODE_ENV=production node esbuild.config.js",
    "start:prod": "node src/scripts/withSettings.ts prod node --enable-source-maps --no-deprecation dist/manager.js",
    "prod": "pnpm build:prod && pnpm start:prod",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix && prettier --write .",
    "flush:dev": "node src/scripts/withSettings.ts dev tsx src/scripts/flush.ts",
    "deploy:dev": "node src/scripts/withSettings.ts dev tsx src/scripts/deploy.ts dev",
    "deploy:prod": "node src/scripts/withSettings.ts prod tsx src/scripts/deploy.ts global",
    "check": "tsx src/scripts/checkDep.ts"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "@snazzah/davey": "0.1.12",
    "bufferutil": "^4.1.0",
    "chalk": "^6.0.0",
    "discord-player": "^7.2.0",
    "discord.js": "^14.27.0",
    "mediaplex": "^1.0.0",
    "openai": "^7.4.0",
    "qrcode-terminal": "^0.12.0",
    "topgg-autoposter": "^2.0.2",
    "ts-pattern": "5.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  }
}
